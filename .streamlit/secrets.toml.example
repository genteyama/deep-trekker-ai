# Copy into Streamlit Community Cloud > App settings > Secrets (or a local .streamlit/secrets.toml,
# which is git-ignored). Placeholders only - never commit real values.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "YOUR-SUPABASE-ANON-KEY"
DATABASE_URL = "postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@YOUR-POOLER-HOST:5432/postgres?sslmode=require"
ALLOWED_EMAILS = "ooteyama@spacexone.com,other@example.com"

# Manufacturer online price books. Leave unset until a person pastes the real URL.
# A Google Spreadsheet edit URL is fetched as that spreadsheet's xlsx export.
# Do not commit real URLs or tokens. config/manufacturer_price_sources.json may hold a URL instead.
# DT40_ONLINE_PRICE_SOURCE_URL = ""
# PT30_ONLINE_PRICE_SOURCE_URL = ""
# SPECTRA_GOLD_ONLINE_PRICE_SOURCE_URL = ""

# Placeholder structure only. Create a dedicated Google Service Account, grant it Viewer access
# to the private Spreadsheet, and paste its JSON fields into Streamlit Secrets.
[google_price_source_service_account]
type = "service_account"
project_id = "YOUR-GCP-PROJECT-ID"
private_key_id = "YOUR-PRIVATE-KEY-ID"
private_key = """-----BEGIN PRIVATE KEY-----
YOUR-PRIVATE-KEY
-----END PRIVATE KEY-----
"""
client_email = "YOUR-SERVICE-ACCOUNT@YOUR-GCP-PROJECT-ID.iam.gserviceaccount.com"
client_id = "YOUR-CLIENT-ID"
token_uri = "https://oauth2.googleapis.com/token"
