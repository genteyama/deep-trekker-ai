# Copy this file to .env when you start using environment variables.
# APP_LANGUAGE: ja or en
APP_LANGUAGE=ja

# Technical Case Agent provider: mock, ollama, or anthropic
TECHNICAL_CASE_PROVIDER=ollama

# Local Ollama (used when TECHNICAL_CASE_PROVIDER=ollama). No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Anthropic connection (used when TECHNICAL_CASE_PROVIDER=anthropic).
# Do not put a real key in source code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Server-side fallback is beta. Keep this false until model behavior is verified.
ANTHROPIC_ENABLE_FALLBACKS=false
